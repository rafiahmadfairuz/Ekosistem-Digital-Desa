APP_NAME="Desa Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_BIND_ADDRESS=127.0.0.1

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=desa_digital
DB_USERNAME=desa_app
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-root-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_ORIGIN=http://localhost:5173

# Keep these keys stable for the lifetime of this local Docker database.
# The app container generates and stores them in its private Docker volume.
DATA_ENCRYPTION_KEY=
IDENTITY_BLIND_INDEX_KEY=

WIFI_GATEWAY=simulated
WIFI_ACCESS_LOG_RETENTION_DAYS=90
