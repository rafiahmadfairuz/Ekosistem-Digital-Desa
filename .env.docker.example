git check-ignore -v .env.docker.exampleAPP_NAME="Desa Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_BIND_ADDRESS=127.0.0.1

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=desa_digital
DB_USERNAME=desa_app
DB_PASSWORD=replace-with-a-unique-local-password
DB_ROOT_PASSWORD=replace-with-a-different-unique-local-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
MAIL_MAILER=log

# Marketplace payments stay simulated until Xendit test credentials are configured.
MARKETPLACE_PAYMENT_MODE=simulated
MARKETPLACE_XENDIT_ENABLED=true
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_PAYOUTS_ENABLED=false
XENDIT_PAYOUT_WEBHOOK_TOKEN=
XENDIT_PAYOUT_SOURCE_OF_FUND=BUSINESS_REVENUE
XENDIT_PAYOUT_PURPOSE_CODE=TRADES
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_TIMEOUT=10

# Email is logged locally by default. For Gmail, configure these in your
# private .env.docker (never commit the App Password):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-full-gmail-address
# MAIL_PASSWORD=your-google-app-password
# MAIL_FROM_ADDRESS=your-full-gmail-address
# MAIL_FROM_NAME="${APP_NAME}"

# Payments are simulated by default. For Xendit sandbox, set mode to test and
# add sandbox credentials only to your private .env.docker.
MARKETPLACE_PAYMENT_MODE=simulated
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_TIMEOUT=10
XENDIT_MARKETPLACE_SELLER_PAYOUT_PERCENT=

# Keep these keys stable for the lifetime of this local Docker database.
# The app container generates and stores them in its private Docker volume.
DATA_ENCRYPTION_KEY=
IDENTITY_BLIND_INDEX_KEY=

WIFI_GATEWAY=simulated
WIFI_ACCESS_LOG_RETENTION_DAYS=90
