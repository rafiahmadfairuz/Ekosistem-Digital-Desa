APP_NAME="Desa Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 local development example. Create a dedicated database and
# least-privilege database user before enabling this configuration.
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=replace-with-a-unique-local-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# config/session.php enables secure cookies automatically when APP_ENV=production.
# For an explicit deployment setting, use SESSION_SECURE_COOKIE=true behind HTTPS.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail verification mail: enable 2-Step Verification and create an App Password.
# In your private .env use MAIL_MAILER=smtp, MAIL_SCHEME=smtp,
# MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, and MAIL_USERNAME=<full Gmail address>.
# Put the 16-character Google App Password in MAIL_PASSWORD (never your account password).
# Set MAIL_FROM_ADDRESS to the same Gmail address. Do not commit those values.

# Marketplace payment integration. Keep simulated until Xendit test credentials
# and the callback token have been added to the private .env.
MARKETPLACE_PAYMENT_MODE=simulated
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_PAYOUTS_ENABLED=false
XENDIT_PAYOUT_WEBHOOK_TOKEN=
XENDIT_PAYOUT_SOURCE_OF_FUND=BUSINESS_REVENUE
XENDIT_PAYOUT_PURPOSE_CODE=TRADES
# Allows Xendit when configured. Checkout stays hidden while mode is simulated or credentials are missing.
MARKETPLACE_XENDIT_ENABLED=true
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public Wi-Fi integration mode. Keep simulated for local development.
# The mikrotik adapter currently fails closed until captive-portal and
# router/RADIUS integration has been configured and security-reviewed.
WIFI_GATEWAY=simulated

# Generate two independent keys with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Prefix each generated value with base64:. Never reuse APP_KEY for either key.
DATA_ENCRYPTION_KEY=
IDENTITY_BLIND_INDEX_KEY=

# Wi-Fi session metadata retention (30–3650 days; default 90 days).
WIFI_ACCESS_LOG_RETENTION_DAYS=90
